{
  "$schema": "https://mintlify.com/docs.json",
  "name": "RunBlob",
  "theme": "mint",
  "colors": {
    "primary": "#8B5CF6",
    "light": "#A78BFA",
    "dark": "#6D28D9"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/lightr.svg",
    "dark": "/logo/darkr.svg",
    "href": "https://runblob.io",
    "height": 50
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "quickstart",
              "authentication",
              "pricing"
            ]
          },
          {
            "group": "Video Generation APIs",
            "pages": [
              "video/veo31",
              "video/sora2",
              "video/kling"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API Documentation",
            "pages": [
              "api-reference/introduction",
              "api-reference/common"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Community",
          "icon": "discord",
          "href": "https://discord.gg/runblob"
        },
        {
          "anchor": "Support",
          "icon": "envelope",
          "href": "mailto:support@runblob.io"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://runblob.io/dashboard"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API Key",
      "href": "https://runblob.io/signup"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "cursor"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://twitter.com/runblob",
      "github": "https://github.com/runblob",
      "discord": "https://discord.gg/runblob"
    }
  },
  "api": {
    "baseUrl": "https://api.runblob.io",
    "auth": {
      "method": "bearer"
    }
  }
}
